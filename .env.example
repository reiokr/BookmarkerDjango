# ============================================================
# .env.example — template for this project's environment file
#
# ⚠️  WARNING: The real `.env` holds LIVE SECRETS (database
#     passwords, API keys, email credentials). It must NEVER be
#     committed to version control. Copy this file to `.env` and
#     fill in real values locally:
#
#       cp .env.example .env
#
# Every variable below is read by bookmarker/settings.py via
# django-environ on startup.
# ============================================================

# --- Django core ---
# Enables verbose error pages and auto-reload in development.
# NEVER set DEBUG=True in production.
DEBUG=True

# Django cryptographic signing key (sessions, CSRF, JWT).
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# --- Database (PostgreSQL) ---
# NOTE: host and port are hardcoded in settings.py (localhost:5432).
DB_NAME=bookmarkerdjango
DB_USER=postgres
DB_PASSWORD=your-db-password-here

# --- URLs ---
# Frontend origin used by CORS middleware; backend origin.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Content-Security-Policy (roadmap step [2.1]) ---
# How bookmarker/csp.py delivers the CSP header on every response:
#   enforce -> "Content-Security-Policy" (default; production setting)
#   report  -> "Content-Security-Policy-Report-Only" (tuning phase; log
#              violations without blocking anything)
#   off     -> no CSP header at all (only for local debugging)
CSP_MODE=enforce

# --- YouTube Data API ---
# Key used for automatic playlist detection.
YOUTUBE_API_KEY=your-youtube-api-key-here

# --- Email (SMTP over SSL, port 465 hardcoded in settings.py) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password-here
